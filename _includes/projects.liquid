<article class="project-card{% unless project.img %} project-card-plain{% endunless %}">
  <a class="project-card-link" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="project-card-media">
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "(min-width: 992px) 420px, 95vw"
          alt="project thumbnail"
          class="project-card-img"
        %}
      {% endif %}
    </div>
    <div class="project-card-body">
      <h2 class="project-card-title">{{ project.title }}</h2>
      <p class="project-card-text">{{ project.description }}</p>
      <span class="project-card-more">Read the project <i class="fa-solid fa-arrow-right"></i></span>
    </div>
  </a>
  {% if project.github %}
    <div class="project-card-repo github-icon">
      <a href="{{ project.github }}" title="Code Repository"><i class="fa-brands fa-github gh-icon"></i></a>
      {% if project.github_stars %}
        <span class="stars" title="GitHub Stars">
          <i class="fa-solid fa-star"></i>
          <span id="{{ project.github_stars }}-stars"></span>
        </span>
      {% endif %}
    </div>
  {% endif %}
</article>
